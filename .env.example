# Path to the SQLite database file
DATABASE_PATH=/app/stock_unifier.db

# GitHub Release DB (Render / Docker)
DB_REPO=Qleoz12/stock-portfolio-db
DB_RELEASE_TAG=v1.0.0
DB_ASSET_NAME=stock_unifier.db
# GITHUB_TOKEN=ghp_...   # set in Render dashboard only — never commit

# Root directory for ETL CSV inputs (optional if using Release DB)
DATA_DIR=../data

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://qleoz12.github.io
